<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- A52 fork: Windows build only (tray icon, WinRT media session, Core Audio). The Linux / macOS build and its
       Unix/ platform code were removed from this fork. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeskmateAgent</AssemblyName>
    <RootNamespace>Deskmate.Agent</RootNamespace>
    <Product>Deskmate</Product>
    <Company>Deskmate</Company>
    <Description>Deskmate desktop agent: feeds the Deskmate Android desk panel over USB or Wi-Fi.</Description>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <!-- no console window; lives in the system tray -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>deskmate.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <PackageReference Include="NAudio" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- QR codes for pairing a phone over Wi-Fi (settings page) -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- every release zip: it bundles the .NET runtime (and NAudio on Windows) -->
    <None Update="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="config.default.json" LogicalName="config.default.json" />
    <EmbeddedResource Include="deskmate.ico" LogicalName="deskmate.ico" />
    <EmbeddedResource Include="settings.html" LogicalName="settings.html" />
    <EmbeddedResource Include="widgets.json" LogicalName="widgets.json" />
    <EmbeddedResource Include="templates.json" LogicalName="templates.json" />
    <!-- the phone's panel, served at /panel/ for the live preview in the layout editor -->
    <EmbeddedResource Include="..\..\android\app\src\main\assets\www\*.*" LogicalName="www/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\android\app\src\main\assets\www\widgets\*.*" LogicalName="www/widgets/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
